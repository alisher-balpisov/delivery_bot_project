# .env file
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# A secret key for signing JWT tokens. You can generate one with: openssl rand -hex 32
AUTH_JWT_SECRET=your_jwt_secret_here

# A secret key for encrypting bot data. You can use the one I generated for you.
AUTH_BOT_ENCRYPTION_KEY=Jlnz8S-LdxToLvHn6JhSUMg0euZ3GBO4z03-sqMkpCY=

# Database connection string
# Example for PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
# Example for SQLite: DATABASE_URL=sqlite+aiosqlite:///./delivery_bot.db
DATABASE_URL=sqlite+aiosqlite:///./delivery_bot.db