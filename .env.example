# ==============================================================================
# Пример конфигурационного файла для Delivery Bot
# ==============================================================================
# Скопируйте этот файл как .env и заполните реальными значениями

# ------------------------------------------------------------------------------
# Основные настройки приложения
# ------------------------------------------------------------------------------
APP_NAME=Delivery Bot
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# Токен от @BotFather
TELEGRAM__BOT_TOKEN=your_bot_token_here

# Настройки вебхука (опционально)
# TELEGRAM__WEBHOOK_URL=https://your-domain.com/webhook
# TELEGRAM__WEBHOOK_SECRET=your_webhook_secret
# TELEGRAM__USE_WEBHOOK=false

TELEGRAM__SKIP_UPDATES=true
TELEGRAM__PARSE_MODE=HTML
TELEGRAM__DISABLE_WEB_PAGE_PREVIEW=true

# Ограничение запросов (rate limiting)
TELEGRAM__RATE_LIMIT_MESSAGES=30
TELEGRAM__RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------------------------
# База данных
# ------------------------------------------------------------------------------
# Для PostgreSQL:
# DATABASE__URL=postgresql+asyncpg://user:password@localhost:5432/delivery_bot

# Для SQLite (для разработки):
DATABASE__URL=sqlite+aiosqlite:///./delivery_bot.db

# Настройки пула соединений
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_PRE_PING=true
DATABASE__POOL_RECYCLE=300
DATABASE__POOL_TIMEOUT=30

# Логирование SQL запросов (для отладки)
DATABASE__ECHO=false

# ------------------------------------------------------------------------------
# JWT Аутентификация
# ------------------------------------------------------------------------------
# Генерировать с помощью: openssl rand -hex 32
JWT__SECRET_KEY=your_jwt_secret_key_here

# Опционально: отдельный ключ для refresh токенов
# JWT__REFRESH_SECRET_KEY=your_refresh_secret_key_here

JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT__REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
# REDIS__STATE_TTL=3600
# REDIS__DATA_TTL=86400

# ------------------------------------------------------------------------------
# API Settings
# ------------------------------------------------------------------------------
API_HOST=localhost
API_PORT=8000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Авторизация и регистрация
# ------------------------------------------------------------------------------
AUTH__REGISTRATION_MAX_ATTEMPTS=3
AUTH__REGISTRATION_CODE_LIFETIME_HOURS=5
AUTH__CODE_LENGTH=8

# ------------------------------------------------------------------------------
# Администрирование
# ------------------------------------------------------------------------------
# Telegram ID супер-администраторов через запятую
ADMIN__SUPER_ADMIN_TELEGRAM_IDS=123456789,987654321

# URL админ-панели (если есть)
# ADMIN__ADMIN_PANEL_URL=https://admin.your-domain.com

ADMIN__HEALTH_CHECK_INTERVAL=300
ADMIN__METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# Хранилище файлов
# ------------------------------------------------------------------------------
FILE_STORAGE__UPLOAD_DIR=uploads
FILE_STORAGE__MAX_FILE_SIZE=20971520
FILE_STORAGE__MAX_PHOTO_WIDTH=1920
FILE_STORAGE__MAX_PHOTO_HEIGHT=1080
FILE_STORAGE__PHOTO_QUALITY=85

# ------------------------------------------------------------------------------
# Логирование
# ------------------------------------------------------------------------------
LOGGING__LEVEL=DEBUG
# LOGGING__FILE_PATH=logs/delivery_bot.log
LOGGING__MAX_FILE_SIZE=20971520
LOGGING__BACKUP_COUNT=5
LOGGING__SQLALCHEMY_LEVEL=WARNING
LOGGING__AIOGRAM_LEVEL=INFO

# ------------------------------------------------------------------------------
# Бизнес-логика (опционально)
# ------------------------------------------------------------------------------
# BUSINESS__MAX_ORDERS_PER_COURIER=5
# BUSINESS__COURIER_INACTIVE_TIMEOUT=300
# BUSINESS__ORDER_AUTO_CANCEL_TIMEOUT=900
# BUSINESS__ORDER_COMPLETION_TIMEOUT=3600
# BUSINESS__MIN_ORDER_PRICE=100
# BUSINESS__MAX_ORDER_PRICE=10000
# BUSINESS__DEFAULT_DELIVERY_PRICE=200
# BUSINESS__NIGHT_DELIVERY_MULTIPLIER=1.5
# BUSINESS__WORK_START_HOUR=8
# BUSINESS__WORK_END_HOUR=22
# BUSINESS__NOTIFICATION_RETRY_ATTEMPTS=3
# BUSINESS__NOTIFICATION_RETRY_DELAY=5
