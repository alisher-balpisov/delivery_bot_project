{
    // Версия схемы конфигурации отладки VS Code
    "version": "0.2.0",
    "configurations": [
        {
            // Конфигурация для отладки FastAPI в режиме разработки с автоперезагрузкой
            "name": "Отладчик Python: FastAPI (Разработка)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.src.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}", // Установка рабочей директории в корень проекта
            "jinja": true,
            // Оптимизация: отлаживать только пользовательский код для повышения производительности
            "justMyCode": true,
            // Показывать возвращаемые значения функций для лучшей отладки
            "showReturnValue": true,
        },
        {
            // Конфигурация для отладки Telegram бота
            "name": "Telegram Bot",
            "type": "debugpy",
            "request": "launch",
            "module": "run_bot",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "showReturnValue": true
        }
    ],
    "compounds": [
        {
            "name": "FastAPI + Telegram Bot",
            "configurations": [
                "Отладчик Python: FastAPI (Разработка)",
                "Telegram Bot"
            ],
            "stopAll": true
        }
    ]
}
